# ---- Model provider ----
# "ollama" (local, no key) or "openai" (cloud, requires OPENAI_API_KEY)
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3-coder:30b
MODEL_TIMEOUT_MS=120000

# Ollama (used when MODEL_PROVIDER=ollama). Note /v1 suffix.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenAI (used when MODEL_PROVIDER=openai). Uncomment and set the key.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Provider allow-list for this project. Default: local only.
# Phase 2 temporary; Phase 3 moves this to Project.allowed_providers.
FORGE_ALLOWED_PROVIDERS=ollama

# Autonomy bounds (unchanged)
MAX_AGENT_STEPS=20
MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=1800

APP_ENV=development

# Control plane
CONTROL_PLANE_ADDR=:8080
CONTROL_PLANE_SELF_URL=http://localhost:8080
ADAPTER_URL=http://localhost:8081
WORKER_IMAGE=forge-worker:dev
STALE_AFTER=60s
FORGE_ALLOWED_PROVIDERS=ollama

# Adapter service
ADAPTER_PORT=8081

MAX_VERIFICATION_ATTEMPTS=2
VERIFICATION_SETUP_TIMEOUT_SECONDS=120s


EVAL_SUITE_DIR=tests/evaluations
EVAL_PROVIDER=ollama
EVAL_MODEL=
EVAL_TIMEOUT=15m
EVAL_MAX_STEPS=25

VITE_API_URL=http://localhost:8080


