# ---- Model ----
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3-coder:30b                # <-- replace with output from ollama list
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
MODEL_TIMEOUT_MS=120000

# ---- Anthropic (Claude) ----
# Required only when MODEL_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...              # your Anthropic API key
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1  # override for proxies
ANTHROPIC_VERSION=2026-10-21             # current; >= 2026-10-21 drops temperature/top_p/top_k

# ---- Persistence ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=forge_ai

# ---- Execution ----
WORKER_IMAGE=forge-worker:dev
WORKSPACE_ROOT=./.forge/workspaces
STALE_AFTER=60s
MAX_VERIFICATION_ATTEMPTS=2
VERIFICATION_SETUP_TIMEOUT_SECONDS=120s

# ---- Control plane ----
# Localhost only; ":8080" would accept connections from other machines.
CONTROL_PLANE_ADDR=127.0.0.1:8080
CONTROL_PLANE_SELF_URL=http://localhost:8080
ADAPTER_URL=http://localhost:8081
# Origins the console is served from (browser requests from anywhere else get no CORS headers).
FORGE_CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- Service trust (Phase 13.1) ----
# Required by both services, same value in both: openssl rand -hex 32
FORGE_ADAPTER_TOKEN=
# Optional: signs each run's callback token. Unset, the control plane keeps a random one in Mongo.
# FORGE_CALLBACK_SECRET=

# ---- People (Phase 13.2) ----
# Create the first user with: echo '<password>' | forge users add <name>   (from services/control-plane: go run ./cmd/forge users add <name>)
# Or set this, start the control plane, and POST /users with it as a Bearer token; it stops working once a user exists.
# FORGE_BOOTSTRAP_TOKEN=
# FORGE_SESSION_TTL=12h
# FORGE_SECURE_COOKIES=false   # true behind HTTPS
# Scripts and the slices send an API token: forge tokens create <user> <name>
# FORGE_TOKEN=

# ---- Adapter ----
ADAPTER_PORT=8081
# The adapter listens on localhost unless told otherwise, and reports runs only to CONTROL_PLANE_SELF_URL.
# ADAPTER_HOST=127.0.0.1
MAX_AGENT_STEPS=20
MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=1800

# ---- Providers ----
# Comma-separated allow-list. Adding a provider here is the opt-in switch:
#   FORGE_ALLOWED_PROVIDERS=ollama,openai,claude
FORGE_ALLOWED_PROVIDERS=ollama,openai,claude

# ---- Agent/skill directories (absolute paths) ----
AGENTS_DIR=/Users/chijiokeagu/go/src/github/chokey2nv/forge-ai/agents   #/absolute/path/to/forge-ai/agents     # replace /absolute/path/to/forge-ai
SKILLS_DIR=/Users/chijiokeagu/go/src/github/chokey2nv/forge-ai/skills     # replace /absolute/path/to/forge-ai

# ---- Eval ----
EVAL_SUITE_DIR=tests/evaluations
EVAL_PROVIDER=ollama
EVAL_MODEL=qwen3-coder:30b                        # match MODEL_NAME
EVAL_TIMEOUT=15m
EVAL_MAX_STEPS=25

# ---- Console ----
VITE_API_URL=http://localhost:8080

# ---- Environment ----
APP_ENV=development