{
  "id": "0001-pagination-off-by-one",
  "fixtureRepo": "tests/evaluations/fixtures/pagination-off-by-one",
  "requirement": "paginate() returns the wrong slice: page is 1-based but it starts one page too late. Fix the off-by-one in src/paginate.js so that paginate(items, page, size) returns the correct slice.",
  "acceptance": [
    "paginate([1,2,3,4,5], 1, 2) returns [1,2]",
    "paginate([1,2,3,4,5], 3, 2) returns [5]",
    "paginate([1,2,3,4], 2, 2) returns [3,4]",
    "all tests in tests/paginate.test.js pass"
  ],
  "checks": {
    "commands": [
      "node -e \"const a=require('assert'),{paginate:p}=require('./src/paginate');a.deepEqual(p([1,2,3,4,5],1,2),[1,2]);a.deepEqual(p([1,2,3,4,5],3,2),[5]);a.deepEqual(p([1,2,3,4],2,2),[3,4]);a.deepEqual(p([1,2],2,2),[])\"",
      "node tests/paginate.test.js"
    ],
    "onlyChanged": [
      "src/paginate.js",
      "tests/"
    ]
  }
}
