# Model runtime (local, no key required)
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=
MODEL_FALLBACK_NAME=
MODEL_TIMEOUT_MS=120000

# Autonomy bounds
MAX_AGENT_STEPS=20
MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=1800

APP_ENV=development

